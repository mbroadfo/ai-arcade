[Unit]
Description=AI Arcade Controller Broker
After=systemd-modules-load.service
Before=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/ai-arcade/controller_broker.py
WorkingDirectory=/opt/ai-arcade
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
