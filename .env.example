# Copy this file OUTSIDE the repository before filling it in.
# Example destination: ~/.config/ai-arcade-backup.env

# Root directory containing the Pi's existing game library.
# Example only; set this to the actual mounted flash-drive path.
ROM_SOURCE=/media/pi/GAMES

# Globally unique S3 bucket created by infra/terraform.
S3_BUCKET=replace-me-ai-arcade-private-backup

# AWS region containing the bucket.
AWS_REGION=us-west-2

# Optional local directory for private manifests/logs.
AI_ARCADE_STATE_DIR=$HOME/.local/state/ai-arcade
